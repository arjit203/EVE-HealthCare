NODE_ENV=development
PORT=3000

# PostgreSQL connection string
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/eve_healthcare?schema=public

# JWT
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=1h

# Shared secret used to verify HMAC signatures on incoming payment webhooks
WEBHOOK_SECRET=change-me-webhook-secret

# Admin account created by `npm run db:seed` (the only way to get an ADMIN user)
ADMIN_NAME=Admin
ADMIN_EMAIL=admin@eve.local
ADMIN_PASSWORD=change-me-admin-password
