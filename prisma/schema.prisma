generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  ADMIN
}

enum BookingStatus {
  PENDING
  CONFIRMED
  FAILED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
}

model User {
  id           String    @id @default(uuid()) @db.Uuid
  name         String
  // Normalised to lowercase before saving, so uniqueness is case-insensitive.
  email        String    @unique
  // bcrypt hash; the plaintext password is never stored.
  passwordHash String    @map("password_hash")
  // Signup always creates USER; ADMIN accounts are only created by the seed script.
  role         Role      @default(USER)
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  bookings     Booking[]

  @@map("users")
}

model DiagnosticCentre {
  id        String       @id @default(uuid()) @db.Uuid
  name      String
  location  String
  createdAt DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)
  tests     CentreTest[]

  @@unique([name, location])
  @@map("diagnostic_centres")
}

// Catalogue of test types (e.g. "Complete Blood Count"), independent of any centre.
model DiagnosticTest {
  id          String       @id @default(uuid()) @db.Uuid
  name        String       @unique
  description String?
  createdAt   DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)
  centres     CentreTest[]

  @@map("diagnostic_tests")
}

// A test offered by a specific centre at a centre-specific price.
// Prices are stored in minor units (paise) to avoid floating-point rounding.
model CentreTest {
  centreId   String           @map("centre_id") @db.Uuid
  testId     String           @map("test_id") @db.Uuid
  priceMinor Int              @map("price_minor")
  isActive   Boolean          @default(true) @map("is_active")
  createdAt  DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)
  centre     DiagnosticCentre @relation(fields: [centreId], references: [id], onDelete: Cascade)
  test       DiagnosticTest   @relation(fields: [testId], references: [id], onDelete: Restrict)
  bookings   Booking[]

  @@id([centreId, testId])
  @@index([testId])
  @@map("centre_tests")
}

model Booking {
  id            String        @id @default(uuid()) @db.Uuid
  userId        String        @map("user_id") @db.Uuid
  centreId      String        @map("centre_id") @db.Uuid
  testId        String        @map("test_id") @db.Uuid
  appointmentAt DateTime      @map("appointment_at") @db.Timestamptz(3)
  // Snapshot of the price at booking time; later price changes must not affect it.
  amountMinor   Int           @map("amount_minor")
  status        BookingStatus @default(PENDING)
  createdAt     DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)
  user          User          @relation(fields: [userId], references: [id], onDelete: Restrict)
  // Composite FK guarantees the test is actually offered by the chosen centre.
  centreTest    CentreTest    @relation(fields: [centreId, testId], references: [centreId, testId], onDelete: Restrict)
  payments      Payment[]

  @@index([userId])
  @@index([centreId, testId])
  @@map("bookings")
}

// A booking can have several payment attempts (e.g. retry after a failure),
// but at most one SUCCESS (enforced by a partial unique index in the migration).
model Payment {
  id                String         @id @default(uuid()) @db.Uuid
  bookingId         String         @map("booking_id") @db.Uuid
  amountMinor       Int            @map("amount_minor")
  status            PaymentStatus  @default(PENDING)
  providerReference String         @unique @map("provider_reference")
  createdAt         DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)
  booking           Booking        @relation(fields: [bookingId], references: [id], onDelete: Restrict)
  webhookEvents     WebhookEvent[]

  @@index([bookingId])
  @@map("payments")
}

// Every webhook delivery is recorded by its provider event ID.
// The unique constraint on event_id is what makes webhook processing idempotent.
model WebhookEvent {
  id         String        @id @default(uuid()) @db.Uuid
  eventId    String        @unique @map("event_id")
  paymentId  String        @map("payment_id") @db.Uuid
  status     PaymentStatus
  payload    Json
  receivedAt DateTime      @default(now()) @map("received_at") @db.Timestamptz(3)
  payment    Payment       @relation(fields: [paymentId], references: [id], onDelete: Restrict)

  @@index([paymentId])
  @@map("webhook_events")
}
