generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  ADMIN
}

enum BookingStatus {
  PENDING
  CONFIRMED
  FAILED
  CANCELLED
}

// Payments are settled immediately by the mock provider, so there is no PENDING payment state.
enum PaymentStatus {
  SUCCESS
  FAILED
}

model User {
  id           String    @id @default(uuid()) @db.Uuid
  name         String
  // Normalised to lowercase before saving, so uniqueness is case-insensitive.
  email        String    @unique
  // bcrypt hash; the plaintext password is never stored.
  passwordHash String    @map("password_hash")
  // Signup always creates USER; ADMIN accounts are only created by the seed script.
  role         Role      @default(USER)
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  bookings     Booking[]

  @@map("users")
}

// No DELETE endpoints exist: every foreign key uses onDelete: Restrict, so a centre, test or
// offering that bookings refer to can never be removed and booking history stays intact.

model DiagnosticCentre {
  id        String               @id @default(uuid()) @db.Uuid
  name      String
  // Free-text address, e.g. "Koramangala, Bengaluru".
  location  String
  createdAt DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime             @updatedAt @map("updated_at") @db.Timestamptz(3)
  offerings CentreTestOffering[]

  // The same chain can have branches in different locations, but not two identical entries.
  @@unique([name, location])
  @@map("diagnostic_centres")
}

// Catalogue of test types (e.g. "Complete Blood Count"), independent of any centre.
model DiagnosticTest {
  id          String               @id @default(uuid()) @db.Uuid
  name        String               @unique
  description String?
  createdAt   DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime             @updatedAt @map("updated_at") @db.Timestamptz(3)
  offerings   CentreTestOffering[]

  @@map("diagnostic_tests")
}

// A test offered by a specific centre at a centre-specific price.
// Price is an integer number of paise (49900 = Rs 499.00) to avoid floating-point rounding;
// a CHECK constraint in the migration SQL keeps it positive.
model CentreTestOffering {
  id         String           @id @default(uuid()) @db.Uuid
  centreId   String           @map("centre_id") @db.Uuid
  testId     String           @map("test_id") @db.Uuid
  pricePaise Int              @map("price_paise")
  createdAt  DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)
  centre     DiagnosticCentre @relation(fields: [centreId], references: [id], onDelete: Restrict)
  test       DiagnosticTest   @relation(fields: [testId], references: [id], onDelete: Restrict)
  bookings   Booking[]

  // A centre offers each test at most once.
  @@unique([centreId, testId])
  @@index([testId])
  @@map("centre_test_offerings")
}

// Status rules live in src/utils/bookingStatus.ts. Payment data lives in the payments table,
// which points to the booking (no payment columns here).
model Booking {
  id                  String             @id @default(uuid()) @db.Uuid
  userId              String             @map("user_id") @db.Uuid
  centreId            String             @map("centre_id") @db.Uuid
  testId              String             @map("test_id") @db.Uuid
  appointmentDateTime DateTime           @map("appointment_date_time") @db.Timestamptz(3)
  // Copied from the offering price when the booking is created (never sent by the client),
  // so later price changes do not affect existing bookings.
  amountPaise         Int                @map("amount_paise")
  status              BookingStatus      @default(PENDING)
  createdAt           DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime           @updatedAt @map("updated_at") @db.Timestamptz(3)
  user                User               @relation(fields: [userId], references: [id], onDelete: Restrict)
  // Composite FK to the offering's unique (centre_id, test_id): the database itself guarantees
  // that the centre really offers the booked test.
  offering            CentreTestOffering @relation(fields: [centreId, testId], references: [centreId, testId], onDelete: Restrict)
  payment             Payment?

  // A partial unique index in the migration SQL also blocks duplicate active bookings
  // (same user, centre, test and time while PENDING or CONFIRMED).
  @@index([userId, createdAt])
  @@index([centreId, testId])
  @@map("bookings")
}

// One payment per booking (unique booking_id). FAILED bookings are terminal, so a failed payment
// is never retried on the same booking; the database itself therefore blocks double payment.
model Payment {
  id                String         @id @default(uuid()) @db.Uuid
  bookingId         String         @unique @map("booking_id") @db.Uuid
  // Copied from the booking inside the payment transaction; never taken from the request.
  amountPaise       Int            @map("amount_paise")
  status            PaymentStatus
  // The mock provider's reference (e.g. "mock_pay_<uuid>"); webhooks identify payments by it.
  providerPaymentId String         @unique @map("provider_payment_id")
  createdAt         DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)
  booking           Booking        @relation(fields: [bookingId], references: [id], onDelete: Restrict)
  webhookEvents     WebhookEvent[]

  @@map("payments")
}

// Every webhook delivery is recorded by its provider event ID.
// The unique constraint on event_id is what makes webhook processing idempotent.
model WebhookEvent {
  id         String        @id @default(uuid()) @db.Uuid
  eventId    String        @unique @map("event_id")
  paymentId  String        @map("payment_id") @db.Uuid
  status     PaymentStatus
  payload    Json
  receivedAt DateTime      @default(now()) @map("received_at") @db.Timestamptz(3)
  payment    Payment       @relation(fields: [paymentId], references: [id], onDelete: Restrict)

  @@index([paymentId])
  @@map("webhook_events")
}
